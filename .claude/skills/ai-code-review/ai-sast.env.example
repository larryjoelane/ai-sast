# AI-SAST pre-commit configuration. Copy to <repo-root>/.ai-sast.env and fill in.
# This file is sourced by the pre-commit hook. DO NOT commit real secrets:
# add ".ai-sast.env" to your .gitignore.

# --- ai-sast engine location (required) ---
# Absolute path to your ai-sast checkout (the repo containing src/main/precommit_scan.py).
AI_SAST_HOME=C:/Users/you/source/repos/Projects/ai-sast

# Optional: explicit python interpreter (e.g. a venv). Defaults to "python".
# AI_SAST_PYTHON=C:/Users/you/source/repos/Projects/ai-sast/.venv/Scripts/python.exe

# --- Two-model selection ---
AI_SAST_LLM=azure            # model 1: initial scan
AI_SAST_VALIDATOR_LLM=azure  # model 2: false-positive validation (empty string disables)

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21

# Auth: set the API key for key-based auth. If omitted, the client falls back to
# Entra ID (DefaultAzureCredential) — requires azure-identity and a signed-in
# identity (az login / managed identity).
AZURE_OPENAI_API_KEY=

# Deployment names (NOT base model names). Model 1 deep scan, model 2 fast check.
AZURE_OPENAI_SCAN_DEPLOYMENT=gpt-4o
AZURE_OPENAI_VALIDATOR_DEPLOYMENT=gpt-4o-mini

# --- Gate behavior ---
# Severities that BLOCK the commit. Comma-separated subset of: critical,high,medium,low
AI_SAST_GATE_SEVERITY=critical,high

# Optional: extra focus for the scanner prompt.
# AI_SAST_CUSTOM_PROMPT=Focus on injection, authz, and secret handling.
